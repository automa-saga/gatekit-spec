    { "active": 4, "enabled": { "featureA": false, "featureB": false } },
    { "active": 5, "enabled": { "featureA": false, "featureB": false } },
    { "active": 6, "enabled": { "featureA": true, "featureB": false } },
    { "active": 99, "enabled": { "featureA": true, "featureB": false } }
  ]
